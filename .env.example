# AFTERCUT — production environment (never commit secrets)

# ── Minds (required) ──
MINDS_BUILDER_API_KEY=
MINDS_DIRECTOR_MIND_ID=

# ── Cloud auth + storage (production) ──
DATABASE_URL=postgresql://…  # Neon Postgres
BETTER_AUTH_SECRET=         # openssl rand -base64 32
BETTER_AUTH_URL=https://your-app.vercel.app

# ── Optional research ──
TAVILY_API_KEY=

# ── Email (password reset) ──
RESEND_API_KEY=
RESEND_FROM=AFTERCUT <onboarding@yourdomain.com>

# ── Google OAuth (Calendar API + sign-in) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram webhook ──
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_DEFAULT_USER_ID=     # studio user id to receive bot imports

# ── Social publish (tokens saved via Settings UI; or OAuth) ──
# X / LinkedIn developer tokens — users paste in Settings
